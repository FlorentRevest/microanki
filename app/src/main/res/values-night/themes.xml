<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MicroAnki" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Floats over whatever app just came to the foreground: the window itself is
         transparent and the scrim + dialog are drawn in Compose. -->
    <style name="Theme.MicroAnki.Flashcard" parent="Theme.MicroAnki">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.MicroAnki.None</item>
    </style>
</resources>
